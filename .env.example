# Copy to .env and insert your own key. Never commit .env.
OPENAI_API_KEY=replace-with-your-api-key
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-flash

# Optional OpenAI-compatible request settings (provider must support them).
max_tokens=65536
thinking=disabled
# Leave effort unset when thinking is disabled.
reasoning_effort=
stream=false

# Required by --brain vista: maximum model requests per decide() call.
# Choose a model/endpoint that supports both images and function tools.
max_model_calls=12
